<Application
    x:Class="Compositor.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#151719" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#202326" />
            <SolidColorBrush x:Key="CanvasBackdropBrush" Color="#111315" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

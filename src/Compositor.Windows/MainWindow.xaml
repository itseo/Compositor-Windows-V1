<Window
    x:Class="Compositor.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Compositor for Windows">

    <Grid Background="{StaticResource EditorBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="{StaticResource PanelBackgroundBrush}">
            <AppBarButton Icon="OpenFile" Label="Open .comp" Click="OpenProject_Click" />
            <AppBarButton Icon="Refresh" Label="Reload" Click="Reload_Click" IsEnabled="False" x:Name="ReloadButton" />
            <AppBarSeparator />
            <AppBarButton Icon="ZoomIn" Label="Fit" Click="Fit_Click" />
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Opacity="0.7" />
                    <Slider x:Name="ZoomSlider"
                            Minimum="5"
                            Maximum="200"
                            Value="50"
                            Width="180"
                            StepFrequency="5"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock x:Name="ZoomLabel" Text="50%" Width="48" VerticalAlignment="Center" />
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" x:Name="ViewportHost" Background="{StaticResource CanvasBackdropBrush}">
                <ScrollViewer x:Name="CanvasScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Enabled"
                              ZoomMode="Disabled">
                    <Grid x:Name="CanvasSurface"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="48">
                        <Border x:Name="CanvasBorder"
                                Background="White"
                                BorderBrush="#45494D"
                                BorderThickness="1">
                            <Canvas x:Name="ProjectCanvas"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top" />
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28"
                        CornerRadius="12"
                        Background="#C9222528">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="Compositor for Windows"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Open a .comp package to begin"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                        <Button Content="Open .comp"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Click="OpenProject_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="#35393D" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="16,14,16,12" Spacing="4">
                    <TextBlock Text="LAYERS" FontSize="12" FontWeight="SemiBold" Opacity="0.65" />
                    <TextBlock x:Name="DocumentInfo" Text="No document" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                </StackPanel>

                <ListView Grid.Row="1"
                          x:Name="LayersList"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          Padding="8,0,8,12">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding KindGlyph}" VerticalAlignment="Center" Opacity="0.65" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding OpacityText}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" Padding="12,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Opacity="0.7" />
            <TextBlock Grid.Column="1" Text="V0.1 · Normal blend renderer" FontSize="12" Opacity="0.45" />
        </Grid>
    </Grid>
</Window>
